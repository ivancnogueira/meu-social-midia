# Copie este arquivo para .env pelo comando: npm run configurar
# Nunca compartilhe nem envie este arquivo para um repositório público.

# Execução — o instalador preenche local ou servidor.
APP_MODE=
APP_BASE_URL=
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173
PREVIEW_TOKEN_TTL_HOURS=168
PREVIEW_TOKEN_SECRET=
MEDIA_TOKEN_SECRET=

# Meta / Instagram — preencha somente após seguir documentacao/configurar-meta.md
META_API_VERSION=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
IMAGE_PUBLIC_BASE_URL=

# Telegram — opcional; usado pela ponte de aprovação.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=
TELEGRAM_POLL_INTERVAL_MS=2000
